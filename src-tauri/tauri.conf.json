{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForgeOS",
  "version": "0.1.0",
  "identifier": "com.forgeos.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ForgeOS",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}

