{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForgeOS",
  "version": "0.2.0",
  "identifier": "com.forgeos.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:sidecar && npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ForgeOS",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SZYWAH",
    "shortDescription": "Personal development memory for independent developers",
    "longDescription": "ForgeOS keeps project context, development history, achievements, and read-only Codex integration in one local-first Windows application.",
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/forgeos-mcp"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
